    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
